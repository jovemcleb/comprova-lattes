# Banco de Dados (PostgreSQL 16)
POSTGRES_DB=comprova_lattes
POSTGRES_USER=comprova_lattes
POSTGRES_PASSWORD=comprova_lattes
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://comprova_lattes:comprova_lattes@localhost:5432/comprova_lattes

# Fila e Cache (Redis 7 / Celery)
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# API FastAPI
API_PORT=8000
ENVIRONMENT=development

# Google Gemini (SDK google-genai)
GEMINI_API_KEY=coloque_sua_chave_aqui
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TEMPERATURE=0.0
