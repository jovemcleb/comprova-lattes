# Configuracao local de desenvolvimento; nao use estas senhas em producao.
POSTGRES_DB=comprova_lattes
POSTGRES_USER=comprova_lattes
POSTGRES_PASSWORD=comprova_lattes
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://comprova_lattes:comprova_lattes@localhost:5432/comprova_lattes

REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0
API_PORT=8000
ENVIRONMENT=development

# Copie para .env e preencha apenas a chave local; nunca versione .env.
GEMINI_API_KEY=coloque_sua_chave_aqui
GEMINI_MODEL=gemini-3.5-flash-lite
# Compatibilidade: Gemini 3+ omite temperatura e usa os defaults do provedor.
GEMINI_TEMPERATURE=0.0
# Timeout por tentativa (ms); tentativas incluem a chamada inicial.
GEMINI_TIMEOUT_MS=120000
GEMINI_MAX_ATTEMPTS=2
