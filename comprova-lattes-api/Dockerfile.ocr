FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app/src

RUN apt-get update && \
    apt-get install -y --no-install-recommends tesseract-ocr tesseract-ocr-por && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY pyproject.toml ./
COPY src ./src
RUN pip install --no-cache-dir -e ".[ocr]"

EXPOSE 8766
CMD ["python", "-m", "comprova_lattes.experiments.review_ocr", "--container-bind", "--host", "0.0.0.0", "--port", "8766", "--preset", "assisted"]
